  locationId: abandoned_shop
  locationName: "\u0417\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
  locationImage: {fileID: 0}
  description: "\u041F\u0443\u0441\u0442\u043E\u0432\u0430\u0432\u0448\u0438\u0439 \u0435\u0449\u0451 \u0434\u043E \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435 \u0433\u043E\u0440\u043E\u0434\u0430. \u041F\u043E\u043B\u043A\u0438 \u0432 \u0437\u0430\u043B\u0435 \u0440\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u044B, \u043D\u043E \u0432 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0435, \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430\u0445 \u0438 arri\xE8re-\u043A\u043E\u043C\u043D\u0430\u0442\u0430\u0445 \u043C\u043E\u0433\u0443\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u044B, \u0441\u0443\u0445\u0438\u0435 \u0440\u0430\u0446\u0438\u043E\u043D\u044B \u0438 \u0431\u0443\u0442\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0432\u043E\u0434\u0430."
  riskDescription: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438: \u043D\u0438\u0436\u0435 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E. \u0428\u0430\u043D\u0441 \u0440\u0430\u043D\u0435\u043D\u0438\u044F: ~25% (\u0443\u0440\u043E\u043D 10\u201330 HP). \u0428\u0430\u043D\u0441 \u0433\u0438\u0431\u0435\u043B\u0438: ~8%. \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0439 \u0440\u0438\u0441\u043A \u0434\u043B\u044F \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E."
  durationDays: 3
