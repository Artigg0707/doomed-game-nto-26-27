  morningReportLine: "\u0423\u0442\u0440\u043E\u043C \u0443 \u0434\u0432\u0435\u0440\u0438 \u043D\u0430\u0448\u043B\u0438 \u043A\u043E\u043D\u0432\u0435\u0440\u0442"
